rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {

      // READ PERMISSIONS
      // Allow reading a single game document if it's waiting OR if the user is a player.
      allow get: if request.auth != null && 
                  (resource.data.status == 'waiting' || request.auth.uid in resource.data.players);
      
      // Allow querying the 'games' collection. This is required for the lobby lookup by shortId.
      // It is safe because the 'get' rule above still protects the actual document data.
      allow list: if request.auth != null;

      // WRITE PERMISSIONS
      // Allow creating a new game.
      allow create: if request.auth != null && 
                     request.resource.data.hostId == request.auth.uid;

      // Allow a player to join a game.
      allow update: if request.auth != null &&
                     resource.data.status == 'waiting' &&
                     !(request.auth.uid in resource.data.players) &&
                     request.resource.data.players.size() < 6;
    }
  }
}